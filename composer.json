			"homepage": "https://josephscott.org/"
		}
	],
	"require": {
		"php": ">=8.2",
		"ext-event": "^3.0.8",
		"workerman/workerman": "^5.1.3",
		"altorouter/altorouter": "^2.0.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.85",
		"josephscott/phpcsfixer-config": "^0.0.4",
		"phpstan/phpstan": "^2.1",
		"pestphp/pest": "^3.8",
		"t7/http-request": "^0.0.3"
	},
	"autoload": {
		"classmap": [
			"src/t7/http/app.php"
		]
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
